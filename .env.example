# ==============================================================================
# 赛博多人股市 (Cyber Stock Simulator) 环境变量配置文件示例
# 部署时请复制为 .env 并按需修改
# ==============================================================================

# Web 服务宿主机暴露端口 (反向代理目标端口，如 1Panel 端口管理中的本地端口)
WEB_PORT=8080

# PostgreSQL 数据库配置
DB_NAME=cyberstock
DB_USER=cyberstock_user
DB_PASSWORD=ChangeThisSecurePassword_2026!

# 系统运行环境 (production / development)
APP_ENV=production

# 会话与加密安全密钥 (建议使用 32 位以上随机字符串)
APP_SECRET=CyberStock_SuperSecretKey_ChangeMe_32Bytes!

# 新用户初始虚拟资金 (单位：元，默认 1,000,000 元)
INITIAL_FUND=1000000

# 默认内测邀请码 (用于未在管理后台配置时的后备邀请码)
DEFAULT_INVITE_CODE=CYBER666

# MCP 云端服务鉴权密钥 (AstrBot 的 headers 中须携带 "Authorization: Bearer <此值>")
# 生成命令: openssl rand -hex 32   (留空则 MCP 无鉴权运行, 仅限内网调试)
MCP_API_KEY=

# 久留美操盘手账号密码 (首次建库时生效; 已有库修改密码见 DEPLOY_1PANEL.md FAQ 5.5)
KURUMI_PASSWORD=KurumiFX2026!

# 时区设置
TZ=Asia/Shanghai
